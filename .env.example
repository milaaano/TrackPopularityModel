# Optional: enables live lookups for artists not in the bundled database.
# Obtain a key at https://www.last.fm/api/account/create.
LASTFM_API_KEY=

# Local frontend origin allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Local explanation model.
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_TIMEOUT=120
